
FROM python:3.14-slim

WORKDIR /app

COPY requirements.txt pyproject.toml ./
COPY src/ ./src/

RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir --no-deps -e .

COPY models/ ./models/

EXPOSE 8000

CMD ["uvicorn", "housing.api:app", "--host", "0.0.0.0", "--port", "8000"]
